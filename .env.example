# Public values for the static site (these are inlined into the browser bundle).
# The anon key is public by design; row level security protects all writes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: This site is a static export (output: "export") with no server runtime,
# so it must NOT rely on any secret keys at runtime. Never put a Supabase
# service-role key or other secrets here — they would be bundled into the
# public build. Server-only secrets (e.g. for the moderation Edge Function)
# live in Supabase project settings, not in this file.
